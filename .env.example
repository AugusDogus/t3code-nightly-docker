# Use nightly or an exact image tag from the GitHub Actions build summary.
# T3's UI manages subsequent updates; changing this tag does not roll them back.
T3CODE_IMAGE_TAG=nightly

# Unraid's conventional nobody:users identity.
T3CODE_UID=99
T3CODE_GID=100

T3CODE_HOST_PORT=3773
T3CODE_DATA_PATH=/mnt/user/appdata/t3code
T3CODE_WORKSPACE_PATH=/mnt/user/dev
